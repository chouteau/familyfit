# Copy to .env beside compose.traefik.yaml, then fill the three empty values.
COMPOSE_FILE=compose.traefik.yaml
FAMILYFIT_IMAGE_TAG=latest
FAMILYFIT_DOMAIN=fit.chouteau.info

# Existing Docker network shared with your Traefik container.
TRAEFIK_NETWORK=
# Existing certificate resolver configured in Traefik.
TRAEFIK_CERTRESOLVER=
# Exact, preferably fixed IP of Traefik on that shared network.
TRAEFIK_PROXY_IP=

TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure

# Optional: dedicated MCP bearer key, at least 32 characters. Empty disables MCP.
# Generate with: openssl rand -hex 32. Never commit the actual value.
MCP_API_KEY=
# true allows reads only; false allows the existing administrator's domain rights.
MCP_READ_ONLY=false

# Initial administrator web connection only; at least 16 characters.
# Generate with: openssl rand -hex 16. Remove after successful setup.
FAMILYFIT_BOOTSTRAP_CODE=
