# Place this map in nginx's http block, once.
map $http_upgrade $familyfit_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name fit.chouteau.info;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name fit.chouteau.info;
    ssl_certificate /etc/letsencrypt/live/fit.chouteau.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fit.chouteau.info/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:5088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $familyfit_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
