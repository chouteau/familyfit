@page "/equipements"
@attribute [Authorize]
@inherits FamilyPage
<PageTitle>Les équipements · FamilyFit</PageTitle>
<div class="page-heading"><div><h1>À chacun sa salle de sport.</h1><p>Un programme qui s’adapte au matériel réellement disponible.</p></div><button class="button primary" @onclick="NewLocation"><Icon Name="plus" />Ajouter un lieu</button></div>
@if (Error != null) { <div class="notice error" role="alert">@Error</div> } @if (Message != null) { <div class="notice success" role="status">@Message</div> }
<div class="management-grid">@foreach (var location in Data.Locations) { var owner = Data.Members.First(x => x.Id == location.MemberId); <article class="panel location-card"><div class="member-card-heading"><span class="large-icon"><Icon Name="location" Size="29" /></span><div><h2>@location.Name</h2><p class="muted">Le lieu de @owner.Nickname</p></div></div><div class="equipment-tags">@foreach (var equipment in FamilyCalendar.Split(location.EquipmentIds)) { <span>@EquipmentCatalogue.All.GetValueOrDefault(equipment, equipment)</span> }</div>@if (Actor.IsAdmin || owner.Id == Actor.MemberId) { <button class="button secondary small" @onclick="() => _form = LocationForm.From(location)">Modifier le matériel</button> }</article> }</div>
@if (!Loading && Data.Locations.Count == 0) { <div class="empty-state panel"><Icon Name="equipment" Size="44" /><h2>Où est-ce qu’on s’entraîne ?</h2><p>Ajoute un premier lieu et coche le matériel disponible.</p></div> }
@if (_form != null) { <section class="panel editor-panel"><h2>@(_form.Id == null ? "Un nouveau lieu" : _form.Name)</h2><EditForm Model="_form" OnValidSubmit="Save" FormName="location-form"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label>Nom du lieu<InputText @bind-Value="_form.Name" placeholder="Maison, Basic-Fit…" /><ValidationMessage For="() => _form.Name" /></label><label>Membre<InputSelect @bind-Value="_form.MemberId" disabled="@(_form.Id != null || !Actor.IsAdmin)">@foreach (var member in Data.Members.Where(x => Actor.IsAdmin || x.Id == Actor.MemberId)) { <option value="@member.Id">@member.Nickname</option> }</InputSelect></label></div><fieldset><legend>Matériel confirmé dans ce lieu</legend><div class="checkbox-grid">@foreach (var equipment in EquipmentCatalogue.All) { <label class="check-option"><input type="checkbox" checked="@_form.Equipment.Contains(equipment.Key)" disabled="@(equipment.Key == "BODYWEIGHT")" @onchange="() => Toggle(equipment.Key)" />@equipment.Value</label> }</div></fieldset><p class="muted">Le nom d’une salle ne préremplit pas son équipement. Après un changement, fais vérifier les programmes à venir par l’administrateur.</p><div class="form-actions"><button class="button primary" type="submit" disabled="@Busy">Enregistrer le lieu</button><button class="button secondary" type="button" @onclick="() => _form = null">Annuler</button></div></EditForm></section> }
@code {
    private LocationForm? _form;
    private void NewLocation() { _form = new() { MemberId = Actor.MemberId }; Error = Message = null; }
    private void Toggle(string key) { if (!_form!.Equipment.Add(key)) _form.Equipment.Remove(key); }
    private async Task Save() { if (_form == null || Busy) return; Busy = true; try { var input = new LocationInput(_form.MemberId, _form.Name, _form.Equipment.ToArray(), _form.Revision); if (await Accept(await Mediator.SaveLocation(User, _form.Id, input, Cancellation), "Lieu et matériel enregistrés.")) _form = null; } finally { Busy = false; } }
}
