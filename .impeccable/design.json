  "narrative": {
    "northStar": "Le rendez-vous sportif en famille",
    "overview": "Les compositions accueil et planning approuvées donnent le ton : fond ivoire, surfaces blanches, titres marine arrondis et accents francs. La mouette sportive apporte une présence encourageante aux bilans et conseils ; elle accompagne les informations utiles sans remplacer les commandes.\n\nLe système privilégie la lisibilité et une progression familiale bienveillante. Les composants restent de vrais liens, boutons, formulaires et tableaux. Les données illustratives portent un repère visible, distinct des données réelles.",
    "keyCharacteristics": [
      "Ivoire chaleureux, marine lisible et accents sportifs.",
      "Typographie arrondie, boutons généreux et cartes souples.",
      "Statuts libellés et repos reconnu dans le planning.",
      "Navigation et consultation adaptées au téléphone."
    ],
    "rules": [
      {
        "name": "Action Contrast",
        "body": "Employer le vert profond pour les commandes à texte blanc ; réserver le vert feuille à la marque et aux repères visuels.",
        "section": "colors"
      },
      {
        "name": "Labeled Status",
        "body": "Ne jamais transmettre un état uniquement par sa couleur : associer un libellé, éventuellement masqué visuellement pour la version compacte, et un pictogramme.",
        "section": "colors"
      }
    ],
    "dos": [
      "Construire des composants réels à partir des compositions approuvées.",
      "Conserver les libellés d'état, le focus visible et les messages de validation.",
      "Garder le compte accessible sur mobile et le défilement des semaines local.",
      "Identifier les données de démonstration et présenter le repos comme un état prévu."
    ],
    "donts": [
      "Utiliser une image de maquette comme interface.",
      "Remplacer le vert profond des actions à texte blanc par le vert décoratif.",
      "Introduire un classement par poids, une inscription publique ou une exécution de séance dans le navigateur.",
      "Présenter une synchronisation Garmin fictive comme une réussite réelle."
    ]
  }
}
